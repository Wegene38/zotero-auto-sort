  "description": "Scan your library, suggest topic categories, and file items into new subcollections without touching existing ones.",
  "author": "Wegene38",
  "icons": {
    "48": "content/icon.svg",
    "96": "content/icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "autosort@wegene38",
      "update_url": "https://raw.githubusercontent.com/Wegene38/zotero-auto-sort/main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
